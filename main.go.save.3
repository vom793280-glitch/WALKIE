	if err != nil {
		log.Fatal("创建 GCM:", err)
	}

	addr, err := net.ResolveUDPAddr("udp", listenAddr)
        if err != nil {
		log.Fatal("监听 UDP 地址失败:", err)
	}

        conn, err := net.ListenUDP("udp", addr)
        if err != nil {

	defer conn.Close()

	server := &Server{
