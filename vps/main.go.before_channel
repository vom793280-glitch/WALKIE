package main

import (
	"log"
	"net"
	"sync"
	"time"
)

const (
	listenAddr    = ":50000"
	maxClients    = 32
	clientTimeout = 60 * time.Second
	talkTimeout   = 30 * time.Second
	maxPacketSize = 1500

	msgHello      = "WALKIE_HELLO"
	msgConnected  = "WALKIE_CONNECTED"
	msgKeepAlive  = "WALKIE_KEEPALIVE"
	msgGoodbye    = "WALKIE_GOODBYE"

	msgTalkStart  = "WALKIE_TALK_START"
	msgTalkStop   = "WALKIE_TALK_STOP"
	msgTalkOK     = "WALKIE_TALK_OK"
	msgTalkBusy   = "WALKIE_TALK_BUSY"
	msgTalkRelease = "WALKIE_TALK_RELEASED"
)

type Client struct {
	Addr     *net.UDPAddr
	LastSeen time.Time
}

type Server struct {
	conn    *net.UDPConn
	mu      sync.RWMutex
	clients map[string]*Client

	talkAddr     *net.UDPAddr
	talkStartAt  time.Time
}

func main() {
	log.SetFlags(log.Ldate | log.Ltime | log.Lmicroseconds)

	addr, err := net.ResolveUDPAddr("udp", listenAddr)
	if err != nil {
		log.Fatal("解析 UDP 地址失败:", err)
	}

	conn, err := net.ListenUDP("udp", addr)
	if err != nil {
		log.Fatal("监听 UDP 50000 失败:", err)
	}

	defer conn.Close()

	server := &Server{
		conn:    conn,
		clients: make(map[string]*Client),
	}

	log.Println("==============================")
	log.Println("私人公网对讲服务器")
	log.Println("==============================")
	log.Println("UDP监听:", listenAddr)
	log.Println("最大在线人数:", maxClients)
	log.Println("客户端超时:", clientTimeout)
	log.Println("讲话超时:", talkTimeout)
	log.Println("连接确认:", msgConnected)
	log.Println("抢麦功能: 已启用")
	log.Println("长按讲话: 已启用")
	log.Println("服务器已启动，等待手机连接...")
	log.Println("==============================")

	go server.talkTimeoutLoop()

	server.run()
}

func (s *Server) run() {
	buffer := make([]byte, maxPacketSize)

	for {
		n, remoteAddr, err := s.conn.ReadFromUDP(buffer)
		if err != nil {
			log.Println("读取 UDP 数据失败:", err)
			continue
		}

		if n <= 0 {
			continue
		}

		data := buffer[:n]
		text := string(data)

		/*
		 * 连接请求
		 */
		if text == msgHello {
			s.updateClient(remoteAddr)

			log.Printf(
				"收到连接请求: %s",
				remoteAddr.String(),
			)

			s.sendMessage(
				remoteAddr,
				msgConnected,
			)

			continue
		}

		/*
		 * 心跳
		 */
		if text == msgKeepAlive {
			s.updateClient(remoteAddr)

			log.Printf(
				"收到心跳: %s",
				remoteAddr.String(),
			)

			continue
		}

		/*
		 * 主动断开
		 */
		if text == msgGoodbye {
			s.removeClient(remoteAddr)

			log.Printf(
				"客户端断开: %s",
				remoteAddr.String(),
			)

			continue
		}

		/*
		 * 请求开始讲话 / 抢麦
		 */
		if text == msgTalkStart {
			s.updateClient(remoteAddr)

			log.Printf(
				"收到抢麦请求: %s",
				remoteAddr.String(),
			)

			s.handleTalkStart(remoteAddr)

			continue
		}

		/*
		 * 请求停止讲话 / 释放麦权
		 */
		if text == msgTalkStop {
			s.updateClient(remoteAddr)

			log.Printf(
				"收到停止讲话: %s",
				remoteAddr.String(),
			)

			s.handleTalkStop(remoteAddr)

			continue
		}

		/*
		 * 其他数据全部视为音频
		 */
		s.updateClient(remoteAddr)

		log.Printf(
			"收到 UDP 音频: %d 字节，来自 %s",
			n,
			remoteAddr.String(),
		)

		s.relayAudio(data, remoteAddr)
	}
}

/*
 * ============================
 * 发送普通消息
 * ============================
 */

func (s *Server) sendMessage(
	addr *net.UDPAddr,
	message string,
) {
	data := []byte(message)

	_, err := s.conn.WriteToUDP(
		data,
		addr,
	)

	if err != nil {
		log.Printf(
			"发送消息失败: %s -> %v",
			addr.String(),
			err,
		)

		return
	}

	log.Printf(
		"发送消息: %s -> %s",
		message,
		addr.String(),
	)
}

/*
 * ============================
 * 客户端管理
 * ============================
 */

func (s *Server) updateClient(
	addr *net.UDPAddr,
) {
	key := addr.String()

	s.mu.Lock()
	defer s.mu.Unlock()

	now := time.Now()

	/*
	 * 清理超时客户端
	 */
	for clientKey, client := range s.clients {

		if now.Sub(client.LastSeen) > clientTimeout {

			log.Println(
				"清理超时客户端:",
				clientKey,
			)

			/*
			 * 如果这个客户端正在讲话，
			 * 同时释放麦权。
			 */
			if s.talkAddr != nil &&
				s.talkAddr.String() == clientKey {

				log.Println(
					"超时客户端占用麦权，自动释放:",
					clientKey,
				)

				s.talkAddr = nil
				s.talkStartAt = time.Time{}
			}

			delete(
				s.clients,
				clientKey,
			)
		}
	}

	/*
	 * 已经存在
	 */
	if client, exists := s.clients[key]; exists {

		client.LastSeen = now

		return
	}

	/*
	 * 达到人数上限
	 */
	if len(s.clients) >= maxClients {

		log.Println(
			"客户端数量已达到上限:",
			key,
		)

		return
	}

	/*
	 * 新客户端
	 */
	s.clients[key] = &Client{
		Addr:     addr,
		LastSeen: now,
	}

	log.Println(
		"新客户端:",
		key,
	)
}

/*
 * ============================
 * 删除客户端
 * ============================
 */

func (s *Server) removeClient(
	addr *net.UDPAddr,
) {
	key := addr.String()

	s.mu.Lock()

	/*
	 * 如果这个客户端正在讲话，
	 * 先释放麦权。
	 */
	if s.talkAddr != nil &&
		s.talkAddr.String() == key {

		log.Println(
			"断开客户端正在讲话，释放麦权:",
			key,
		)

		s.talkAddr = nil
		s.talkStartAt = time.Time{}
	}

	delete(
		s.clients,
		key,
	)

	s.mu.Unlock()
}

/*
 * ============================
 * 抢麦
 * ============================
 */

func (s *Server) handleTalkStart(
	addr *net.UDPAddr,
) {
	key := addr.String()

	s.mu.Lock()

	/*
	 * 检查客户端是否存在
	 */
	if _, exists := s.clients[key]; !exists {

		s.mu.Unlock()

		log.Println(
			"抢麦失败：客户端不存在:",
			key,
		)

		return
	}

	/*
	 * 已经是当前讲话的人
	 */
	if s.talkAddr != nil &&
		s.talkAddr.String() == key {

		s.mu.Unlock()

		s.sendMessage(
			addr,
			msgTalkOK,
		)

		return
	}

	/*
	 * 已经有人讲话
	 */
	if s.talkAddr != nil {

		currentTalker := s.talkAddr.String()

		s.mu.Unlock()

		log.Printf(
			"抢麦失败: %s，当前讲话者: %s",
			key,
			currentTalker,
		)

		s.sendMessage(
			addr,
			msgTalkBusy,
		)

		return
	}

	/*
	 * 抢麦成功
	 */
	s.talkAddr = addr
	s.talkStartAt = time.Now()

	s.mu.Unlock()

	log.Println(
		"==============================",
	)

	log.Println(
		"抢麦成功:",
		key,
	)

	log.Println(
		"讲话最长时间:",
		talkTimeout,
	)

	log.Println(
		"==============================",
	)

	/*
	 * 通知讲话者
	 */
	s.sendMessage(
		addr,
		msgTalkOK,
	)
}

/*
 * ============================
 * 释放麦权
 * ============================
 */

func (s *Server) handleTalkStop(
	addr *net.UDPAddr,
) {
	key := addr.String()

	s.mu.Lock()

	/*
	 * 不是当前讲话者
	 */
	if s.talkAddr == nil ||
		s.talkAddr.String() != key {

		s.mu.Unlock()

		log.Println(
			"释放麦权失败：不是当前讲话者:",
			key,
		)

		return
	}

	/*
	 * 释放麦权
	 */
	s.talkAddr = nil
	s.talkStartAt = time.Time{}

	s.mu.Unlock()

	log.Println(
		"讲话结束，释放麦权:",
		key,
	)

	/*
	 * 通知原讲话者
	 */
	s.sendMessage(
		addr,
		msgTalkRelease,
	)
}

/*
 * ============================
 * 讲话超时检查
 * ============================
 */

func (s *Server) talkTimeoutLoop() {

	ticker := time.NewTicker(
		500 * time.Millisecond,
	)

	defer ticker.Stop()

	for range ticker.C {

		s.mu.Lock()

		if s.talkAddr != nil {

			elapsed :=
				time.Since(
					s.talkStartAt,
				)

			if elapsed >= talkTimeout {

				addr :=
					s.talkAddr

				log.Println(
					"==============================",
				)

				log.Println(
					"讲话达到30秒，自动释放麦权:",
					addr.String(),
				)

				log.Println(
					"==============================",
				)

				s.talkAddr = nil
				s.talkStartAt = time.Time{}

				s.mu.Unlock()

				/*
				 * 通知手机停止讲话
				 */
				s.sendMessage(
					addr,
					msgTalkRelease,
				)

				continue
			}
		}

		s.mu.Unlock()
	}
}

/*
 * ============================
 * 音频转发
 * ============================
 */

func (s *Server) relayAudio(
	data []byte,
	sender *net.UDPAddr,
) {
	senderKey := sender.String()

	/*
	 * 只有当前抢到麦的人
	 * 才允许发送音频。
	 */
	s.mu.RLock()

	if s.talkAddr == nil ||
		s.talkAddr.String() != senderKey {

		s.mu.RUnlock()

		log.Println(
			"拒绝音频：该客户端没有麦权:",
			senderKey,
		)

		return
	}

	clients := make(
		[]*Client,
		0,
		len(s.clients),
	)

	for _, client := range s.clients {

		if time.Since(client.LastSeen) <= clientTimeout {

			clients = append(
				clients,
				client,
			)
		}
	}

	s.mu.RUnlock()

	/*
	 * 转发给其他所有在线客户端
	 */
	for _, client := range clients {

		if client.Addr.String() ==
			senderKey {

			continue
		}

		_, err :=
			s.conn.WriteToUDP(
				data,
				client.Addr,
			)

		if err != nil {

			log.Printf(
				"转发失败: %s: %v",
				client.Addr.String(),
				err,
			)

			continue
		}

		log.Printf(
			"转发音频: %d 字节 %s -> %s",
			len(data),
			senderKey,
			client.Addr.String(),
		)
	}
}