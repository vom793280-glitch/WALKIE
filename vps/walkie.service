[Unit]
Description=WALKIE V24.9.2 UDP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/walkie/walkie-v24.9.2
WorkingDirectory=/opt/walkie

Restart=always
RestartSec=3

KillSignal=SIGTERM
TimeoutStopSec=10

StandardOutput=append:/opt/walkie/walkie.log
StandardError=append:/opt/walkie/walkie-error.log

NoNewPrivileges=true

[Install]
WantedBy=multi-user.target