func (s *Server) sendChannelInfoToClient(
	addr *net.UDPAddr,
) {

	client, accepted :=
		s.updateClient(
			addr,
		)

	if !accepted ||
		client == nil {

		return
	}

	s.mu.RLock()

	channel, exists :=
		s.channels[client.ChannelName]

	if !exists {

		s.mu.RUnlock()

		s.sendMessage(
			addr,
			msgChannelError+":NOT_FOUND",
		)

		return
	}

	count :=
		s.channelMemberCountLocked(
