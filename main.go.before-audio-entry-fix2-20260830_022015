// ============================================================

func cleanChannelName(
	name string,
) string {

	name =
		strings.TrimSpace(
			name,
		)

	name =
		strings.ReplaceAll(
			name,
			":",
			"",
		)

	name =
		strings.ReplaceAll(
			name,
			"|",
			"",
		)

	name =
		strings.ReplaceAll(
			name,
			";",
			"",
		)

	name =
		strings.ReplaceAll(
			name,
			",",
			"",
		)

	name =
		strings.ReplaceAll(
			name,
			"\n",
			"",
		)

	name =
		strings.ReplaceAll(
			name,
			"\r",
			"",
		)

	runes :=
		[]rune(
			name,
		)

	if len(runes) > 24 {

		name =
			string(
				runes[:24],
			)
	}

	return name
}

