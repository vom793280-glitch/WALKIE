func (s *Server) handleLeaveChannel(
	addr *net.UDPAddr,
) {

	if addr == nil {
		return
	}

	key :=
		addr.String()

	s.mu.Lock()

	client, exists :=
		s.clients[key]

	s.mu.Unlock()

	if !exists {

		var accepted bool

		client, accepted =
			s.updateClient(
				addr,
			)

		if !accepted ||
			client == nil {

			return
		}
	}

	s.mu.Lock()

	client, exists =
		s.clients[key]

	if !exists ||
		client == nil {

		s.mu.Unlock()
		return
	}

	oldChannel :=
		client.ChannelName

	if oldChannel == "" {

		oldChannel =
			defaultChannel
