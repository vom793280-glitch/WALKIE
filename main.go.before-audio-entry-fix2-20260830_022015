// ============================================================
// 频道人数
// ============================================================

func (s *Server) channelMemberCountLocked(
	channelName string,
) int {

	if channelName == "" {
		return 0
	}

	/*
	 * ========================================================
	 * V21 在线人数唯一数据源
	 *
	 * 只统计：
	 * 1. 当前频道
	 * 2. 未超时
	 * 3. 有效 UserID
	 *
	 * 同一个 UserID 即使因为：
	 * Wi-Fi / 移动网络 / UDP 端口变化
	 * 暂时留下多个 Client，
	 * 最终也只计算 1 人。
	 * ========================================================
	 */

	users :=
		make(
			map[string]bool,
		)

	now :=
		time.Now()

	for _, client := range s.clients {

		if client == nil ||
			client.ChannelName !=
				channelName {

			continue
		}

		if now.Sub(
			client.LastSeen,
		) > clientTimeout {

			continue
		}

		userID :=
			strings.TrimSpace(
				client.UserID,
			)

		/*
		 * 没有 UserID 的临时 UDP Client
		 * 不参与真实在线人数统计。
		 */
		if userID == "" {
			continue
		}

		users[userID] = true
	}

	return len(users)
}

// ============================================================
// 频道成员列表
//
// 老协议继续保留：
//
// WALKIE_CHANNEL_MEMBERS:
// channel:
// userid,username,online,lastSeen;
//
// ============================================================

func (s *Server) buildChannelMembersLocked(
	channelName string,
) string {

	type member struct {
		id       string
		username string
		lastSeen int64
	}

	membersByID :=
		make(
			map[string]member,
		)

	now :=
		time.Now()

	for _, client := range s.clients {

		if client == nil ||
			client.ChannelName !=
				channelName {

			continue
		}

		if now.Sub(
			client.LastSeen,
		) > clientTimeout {

			continue
		}

		id :=
			client.UserID

		if id == "" &&
			client.Addr != nil {

			id =
				client.Addr.String()
		}

		current :=
			member{
				id:       client.UserID,
				username: client.Username,
				lastSeen: client.LastSeen.Unix(),
			}

		existing, ok :=
			membersByID[id]

		if !ok ||
			current.lastSeen >
				existing.lastSeen {

			membersByID[id] =
				current
		}
	}

	members :=
		make(
			[]member,
			0,
			len(membersByID),
		)

	for _, m := range membersByID {

		members =
			append(
				members,
				m,
			)
	}

	for i := 0; i < len(members); i++ {

		for j := i + 1; j < len(members); j++ {

			if members[j].username <
				members[i].username {

				members[i],
					members[j] =
					members[j],
					members[i]
			}
		}
	}

	items :=
		make(
			[]string,
			0,
			len(members),
		)

	for _, m := range members {

		items =
			append(
				items,
				fmt.Sprintf(
					"%s,%s,online,%d",
					cleanUsername(
						m.id,
					),
					cleanUsername(
						m.username,
					),
					m.lastSeen,
				),
			)
	}

	return msgChannelMembers +
		":" +
		cleanChannelName(
			channelName,
		) +
		":" +
		strings.Join(
			items,
			";",
		)
}

// ============================================================
// V20 简化用户列表
//
// 格式：
//
// WALKIE_USER_LIST:public:U-D-123|张三;U-D-456|李四
//
// 这个协议专门给 Android UI 使用。
// ============================================================

func (s *Server) buildUserListLocked(
	channelName string,
) string {

	type userInfo struct {
		id       string
		username string
		lastSeen int64
	}

	usersByID :=
		make(
			map[string]userInfo,
		)

	now :=
		time.Now()

	for _, client := range s.clients {

		if client == nil ||
			client.ChannelName !=
				channelName {

			continue
		}

		if now.Sub(
			client.LastSeen,
		) > clientTimeout {

			continue
		}

		id :=
			cleanUsername(
				client.UserID,
			)

		if id == "" &&
			client.Addr != nil {

			id =
				cleanUsername(
					client.Addr.String(),
				)
		}

		username :=
			cleanUsername(
				client.Username,
			)

		if username == "" {

			username =
				"未命名用户"
		}

		current :=
			userInfo{
				id:       id,
				username: username,
				lastSeen: client.LastSeen.Unix(),
			}

		existing, exists :=
			usersByID[id]

		if !exists ||
			current.lastSeen >
				existing.lastSeen {

			usersByID[id] =
				current
		}
	}

	users :=
		make(
			[]userInfo,
			0,
			len(usersByID),
		)

	for _, item := range usersByID {

		users =
			append(
				users,
				item,
			)
	}

	for i := 0; i < len(users); i++ {

		for j := i + 1; j < len(users); j++ {

			/*
			 * 中文昵称排序不保证字典顺序，
			 * 但稳定即可。
			 */
			if users[j].username <
				users[i].username {

				users[i],
					users[j] =
					users[j],
					users[i]
			}
		}
	}

	items :=
		make(
			[]string,
			0,
			len(users),
		)

	for _, user := range users {

		items =
			append(
				items,
				cleanUsername(
					user.id,
				)+"|"+
					cleanUsername(
						user.username,
					),
			)
	}

	return msgUserList +
		":" +
		cleanChannelName(
			channelName,
		) +
		":" +
		strings.Join(
			items,
			";",
		)
}

