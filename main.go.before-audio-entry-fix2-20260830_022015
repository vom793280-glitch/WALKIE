// 构造频道列表
// ============================================================

func (s *Server) buildChannelListLocked() string {

	names :=
		make(
			[]string,
			0,
			len(s.channels),
		)

	for name := range s.channels {

		names =
			append(
				names,
				name,
			)
	}

	sortStrings(
		names,
	)

	items :=
		make(
			[]string,
			0,
			len(names),
		)

	for _, name := range names {

		channel :=
			s.channels[name]

		count :=
			s.channelMemberCountLocked(
				name,
			)

		items =
			append(
				items,
				fmt.Sprintf(
					"%s,%s,%d",
					channel.Name,
					channel.ChannelType,
					count,
				),
			)
	}

	return msgChannelList +
		":" +
		strings.Join(
			items,
			";",
		)
}

