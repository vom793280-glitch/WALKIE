// 广播有人讲话
// ============================================================

func (s *Server) broadcastTalkStart(
	channelName string,
	username string,
) {
	message := fmt.Sprintf(
		"%s:%s:%s",
		msgTalkBroadcast,
		cleanChannelName(channelName),
		cleanUsername(username),
	)

	s.broadcastToChannel(
		channelName,
		message,
	)
}

